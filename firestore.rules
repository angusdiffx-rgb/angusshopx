rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if current user is owner of document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check admin status
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'otinrealxz@gmail.com' ||
        request.auth.token.email == 'angusdiffx@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    // Test collection for SDK connection probe
    match /test/{docId} {
      allow read, write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }
    
    // Products collection (public catalog, admin manages)
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Orders collection
    match /orders/{orderId} {
      allow read, write: if true;
    }
    
    // Inventory collection
    match /inventory/{inventoryId} {
      allow read, write: if true;
    }
    
    // Wallet transactions (audit ledger)
    match /wallet_transactions/{txId} {
      allow read, write: if true;
    }
    
    // Deposits collection
    match /deposits/{depositId} {
      allow read, write: if true;
    }
    
    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Coupons collection
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Notifications collection
    match /notifications/{notifId} {
      allow read, write: if true;
    }
    
    // Audit logs collection
    match /audit_logs/{logId} {
      allow read, write: if true;
    }
    
    // Settings collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
